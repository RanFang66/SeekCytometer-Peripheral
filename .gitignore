# ================================
# STM32CubeIDE / Eclipse workspace
# ================================

# Eclipse / CubeIDE metadata (machine/workspace specific)
.settings/
.metadata/
.recommenders/
*.launch

# NOTE: .project and .cproject are intentionally tracked.
# They contain the STM32CubeIDE project description and C/C++ build
# configuration (toolchain, includes, defines, linker script). They are
# cross-platform (Win/Linux/Mac) as long as the same CubeIDE version is used,
# and are required for the project to be importable / buildable after clone.

# ================================
# Build output directories
# ================================

Debug/
Release/
build/
out/

# Generated binary files
*.elf
*.hex
*.bin
*.map
*.lst
*.siz

# ================================
# Temporary & backup files
# ================================

*~
*.bak
*.tmp
*.log
*.swp
*.swo

# ================================
# OS-specific files
# ================================

.DS_Store
Thumbs.db

# ================================
# CubeIDE / GCC intermediate files
# ================================

*.o
*.d
*.su
*.cyclo
*.gcno
*.gcda
*.gcov

# ================================
# User-specific CubeMX files
# ================================

*.mxuser

